<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Html\*.html" />
    <EmbeddedResource Include="Resources\Css\*.css" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpBrowser.JsEngineProtocol\UpBrowser.JsEngineProtocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="*" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
  </ItemGroup>
</Project>
