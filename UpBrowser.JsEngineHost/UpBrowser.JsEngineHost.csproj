<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpBrowser.JsEngineProtocol\UpBrowser.JsEngineProtocol.csproj" />
    <ProjectReference Include="..\UpBrowser.Core\UpBrowser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JavaScriptEngineSwitcher.Core" Version="*" />
    <PackageReference Include="JavaScriptEngineSwitcher.Jint" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DomSetup.js">
      <LogicalName>UpBrowser.JsEngineHost.DomSetup.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>