<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- 启用动态代码支持，让 Jurassic 等通过 Assembly.LoadFrom 加载的引擎可以正常工作 -->
    <IlcDynamicCodeSupportNeeded>true</IlcDynamicCodeSupportNeeded>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
    <TrimmerRootAssembly Include="UpBrowser.Core" />
    <TrimmerRootAssembly Include="UpBrowser.Rendering" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpBrowser.Rendering\UpBrowser.Rendering.csproj" />
    <ProjectReference Include="..\UpBrowser.Core\UpBrowser.Core.csproj" />
    <ProjectReference Include="..\UpBrowser.Input\UpBrowser.Input.csproj" />
  </ItemGroup>

  <!-- V8 native DLL is downloaded on-demand via JsEngineDownloader -->
</Project>
