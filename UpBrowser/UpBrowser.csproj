<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- 启用动态代码支持，让 Jurassic 等通过 Assembly.LoadFrom 加载的引擎可以正常工作 -->
    <IlcDynamicCodeSupportNeeded>true</IlcDynamicCodeSupportNeeded>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
    <TrimmerRootAssembly Include="UpBrowser.Core" />
    <TrimmerRootAssembly Include="UpBrowser.Rendering" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpBrowser.Rendering\UpBrowser.Rendering.csproj" />
    <ProjectReference Include="..\UpBrowser.Core\UpBrowser.Core.csproj" />
    <ProjectReference Include="..\UpBrowser.Input\UpBrowser.Input.csproj" />
    <!-- JsEngineHost 以独立进程运行，不作为程序集引用，也不加 ProjectReference（避免 AOT/SelfContained 冲突） -->
  </ItemGroup>

  <!-- 构建时确保 JsEngineHost 已编译，并复制到输出目录 -->
  <Target Name="EnsureJsEngineHostBuilt" BeforeTargets="CopyJsEngineHostOutput">
    <Exec Command="dotnet restore &quot;..\UpBrowser.JsEngineHost\UpBrowser.JsEngineHost.csproj&quot;" />
    <Exec Command="dotnet build &quot;..\UpBrowser.JsEngineHost\UpBrowser.JsEngineHost.csproj&quot; -c $(Configuration) -f net10.0" />
  </Target>

  <Target Name="CopyJsEngineHostOutput" AfterTargets="Build" DependsOnTargets="EnsureJsEngineHostBuilt">
    <PropertyGroup>
      <JsEngineHostOutDir>$(MSBuildThisFileDirectory)..\UpBrowser.JsEngineHost\bin\$(Configuration)\net10.0\</JsEngineHostOutDir>
    </PropertyGroup>
    <ItemGroup>
      <JsEngineHostFiles Include="$(JsEngineHostOutDir)UpBrowser.JsEngineHost.*" />
      <JsEngineHostFiles Include="$(JsEngineHostOutDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(JsEngineHostFiles)" DestinationFolder="$(TargetDir)"
          OverwriteReadOnlyFiles="true" />
    <Message Text="Copied @(JsEngineHostFiles->Count()) JsEngineHost files from $(JsEngineHostOutDir) to $(TargetDir)" Importance="high" />
  </Target>

  <!-- 发布时自动编译 JsEngineHost 并复制到输出目录 -->
  <Target Name="PublishJsEngineHost" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <Exec Command="dotnet publish &quot;..\UpBrowser.JsEngineHost\UpBrowser.JsEngineHost.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) -o &quot;$(PublishDir)&quot;" />
    <Message Text="JsEngineHost published to $(PublishDir)" Importance="high" />
  </Target>

  <!-- V8 native DLL is downloaded on-demand via JsEngineDownloader -->
</Project>
