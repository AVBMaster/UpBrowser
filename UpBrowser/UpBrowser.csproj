<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- 启用动态代码支持，让 Jurassic 等通过 Assembly.LoadFrom 加载的引擎可以正常工作 -->
    <IlcDynamicCodeSupportNeeded>true</IlcDynamicCodeSupportNeeded>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
    <TrimmerRootAssembly Include="UpBrowser.Core" />
    <TrimmerRootAssembly Include="UpBrowser.Rendering" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpBrowser.Rendering\UpBrowser.Rendering.csproj" />
    <ProjectReference Include="..\UpBrowser.Core\UpBrowser.Core.csproj" />
    <ProjectReference Include="..\UpBrowser.Input\UpBrowser.Input.csproj" />
    <!-- JsEngineHost 以独立进程运行，不作为程序集引用 -->
    <!-- 发布时通过 PublishJsEngineHost 目标编译并复制到输出目录 -->
  </ItemGroup>

  <!-- 开发时复制 JsEngineHost 输出文件到主项目输出目录 -->
  <Target Name="CopyJsEngineHostOutput" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <MSBuild Projects="..\UpBrowser.JsEngineHost\UpBrowser.JsEngineHost.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0" />
    <ItemGroup>
      <JsEngineHostFiles Include="..\UpBrowser.JsEngineHost\bin\$(Configuration)\net10.0\UpBrowser.JsEngineHost.*" />
      <JsEngineHostFiles Include="..\UpBrowser.JsEngineHost\bin\$(Configuration)\net10.0\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(JsEngineHostFiles)" DestinationFolder="$(TargetDir)" />
  </Target>

  <!-- 发布时自动编译 JsEngineHost 并复制到输出目录 -->
  <Target Name="PublishJsEngineHost" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <Exec Command="dotnet publish &quot;..\UpBrowser.JsEngineHost\UpBrowser.JsEngineHost.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) -o &quot;$(PublishDir)&quot;" />
    <Message Text="JsEngineHost published to $(PublishDir)" Importance="high" />
  </Target>

  <!-- V8 native DLL is downloaded on-demand via JsEngineDownloader -->
</Project>
